{
  "name": "fourier-agent",
  "version": "1.1.5",
  "type": "module",
  "description": "Policy-constrained storage budget agent for Filecoin Onchain Cloud — AI proposes, deterministic code disposes",
  "license": "MIT",
  "bin": {
    "fourier": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "filecoin",
    "usdfc",
    "storage",
    "agent",
    "ai",
    "onchain",
    "payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabxtract/fourier.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@filoz/synapse-sdk": "^1.2.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  }
}
